# ============================================
# AnjosDevOS - Environment Variables
# ============================================
# Copie este arquivo para .env.local e preencha
# cp .env.example .env.local

# ============================================
# NetworkTools API (Provider Padrão)
# ============================================
# Obtenha sua chave em: https://t.me/GPT4_Unlimit_bot?start=api
NETWORK_TOOLS_API_KEY=

# ============================================
# OpenAI
# ============================================
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================
# Anthropic (Claude)
# ============================================
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================
# Google AI (Gemini)
# ============================================
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ============================================
# DeepSeek
# ============================================
# Obtenha em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ============================================
# xAI (Grok)
# ============================================
# Obtenha em: https://console.x.ai/
XAI_API_KEY=

# ============================================
# Mistral AI
# ============================================
# Obtenha em: https://console.mistral.ai/
MISTRAL_API_KEY=

# ============================================
# Groq
# ============================================
# Obtenha em: https://console.groq.com/
GROQ_API_KEY=

# ============================================
# Together AI
# ============================================
# Obtenha em: https://api.together.xyz/
TOGETHER_API_KEY=

# ============================================
# Configurações do App
# ============================================
# URL base da API (opcional)
# NEXT_PUBLIC_API_BASE_URL=https://yellowfire.ru/v1

# Porta do servidor (opcional)
# PORT=3000

# ============================================
# Desenvolvimento
# ============================================
# Modo de debug
# DEBUG=false

# Log level
# LOG_LEVEL=info
